    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a master viral video editor and comedian, an expert in finding the single moment in a long video that is destined to become a hilarious, shareable clip on TikTok, YouTube Shorts, or Instagram Reels. Your task is to analyze the following video transcript and identify the absolute funniest, most absurd, or most surprisingly witty segment.\n\nTo find the perfect clip, pay close attention to these signals in the text:\n\nLaughter: Explicit mentions like (laughing), (laughs), or (giggles) are extremely strong indicators of a punchline.\nSound Effects: Comical sounds like (comical sound effect), (record scratch), (boing), or even dramatic sounds (dramatic music) that punctuate a joke.\nHyperbole and Absurdity: Look for wildly exaggerated claims or ridiculous statements (e.g., \"a chicken nugget so big it requires its own zip code\").\nBanter and Sarcasm: Quick, witty exchanges between speakers or clear use of sarcasm.\nThe Punchline: Identify a clear setup followed by an unexpected and funny payoff.\nThe clip you select MUST be between 15 and 30 seconds long.\n\nYour entire response MUST be only the start and end timestamps in the exact SRT format, with no other text, explanation, or notes.\n\nFormat: START: HH:MM:SS,mmm END: HH:MM:SS,mmm\n\nHere is the transcript:\n{{$input.item.json.stdout}}",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        1320,
        0
      ],
      "id": "5865096c-7c47-4cd3-b737-abef56f641c8",
      "name": "5. Hook Bul (Gemini)"
    },
    {
      "parameters": {
        "jsCode": "// Gelen verinin 'text' alanını al\nconst geminiText = $input.item.json.text;\n\n// Metin gelip gelmediğini kontrol et\nif (!geminiText) {\n  throw new Error(\"Gemini'den metin gelmedi veya 'text' alanı boş.\");\n}\n\nlet startTime;\nlet endTime;\n\n// Önce ideal format olan \"START: ... END: ...\" yapısını kontrol et\nif (geminiText.includes('START:') && geminiText.includes('END:')) {\n  console.log(\"İdeal format tespit edildi.\");\n  try {\n    startTime = geminiText.split('END:')[0].replace('START:', '').trim().replace(',', '.');\n    endTime = geminiText.split('END:')[1].trim().replace(',', '.');\n  } catch (e) {\n    throw new Error(`İdeal format ayrıştırılırken hata oluştu: ${e.message}`);\n  }\n}\n// Eğer ideal format yoksa, \"-->\" içeren altyazı formatını kontrol et\nelse if (geminiText.includes('-->')) {\n  console.log(\"Alternatif '-->' formatı tespit edildi.\");\n  try {\n    const parts = geminiText.split('-->');\n    startTime = parts[0].trim().replace(',', '.');\n    // Bitiş zamanından sonra gelen cümle metnini temizle\n    endTime = parts[1].split('\\n')[0].trim().replace(',', '.');\n  } catch (e) {\n    throw new Error(`'-->' formatı ayrıştırılırken hata oluştu: ${e.message}`);\n  }\n}\n// Eğer iki format da bulunamazsa, hata ver\nelse {\n  throw new Error(`Beklenmedik Gemini formatı. Gelen Metin: \"${geminiText}\"`);\n}\n\n// Son bir kontrol: Değişkenler geçerli mi?\nif (!startTime || !endTime || !startTime.includes(':') || !endTime.includes(':')) {\n   throw new Error(`Zaman damgaları geçerli bir şekilde ayrıştırılamadı. Sonuç: startTime=${startTime}, endTime=${endTime}`);\n}\n\n// Sonuçları bir sonraki noda gönder\nreturn {\n  startTime: startTime,\n  endTime: endTime\n};"
      },
